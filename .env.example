# .env.example - copy this to .env and fill in your values.
# Never commit your real .env file. It contains your bot token.

BOT_TOKEN=YOUR_BOT_TOKEN_HERE
PREFIX=,

# Optional: comma-separated Discord user IDs that should count as bot owners.
OWNER_IDS=,

# Optional fallback channel IDs. Most server setup can also be handled in Discord
# with commands like ,setmodlog and ,settings.
MOD_LOG_CHANNEL_ID=0
INVITE_LOG_CHANNEL_ID=0
JOIN_LOG_CHANNEL_ID=0

# SQLite database path.
DB_PATH=data/bot.db

# Optional: enable Spotify links in music commands. Create a Spotify developer
# app, then copy its Client ID and Client Secret here.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MAX_TRACKS=50

# Failure handling. Use "retry" to restart after unexpected crashes, or "close"
# to exit instead. Retry delay is in seconds.
BOT_FAILURE_MODE=retry
BOT_RETRY_DELAY_SECONDS=5
