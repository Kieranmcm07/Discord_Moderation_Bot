# .env.example - copy this to .env and fill in your values.
# Never commit your real .env file. It contains your bot token.

BOT_TOKEN=YOUR_BOT_TOKEN_HERE
PREFIX=,

# Optional: comma-separated Discord user IDs that should count as bot owners.
OWNER_IDS=,

# Optional fallback channel IDs. Most server setup can also be handled in Discord
# with commands like ,setmodlog and ,settings.
MOD_LOG_CHANNEL_ID=0
INVITE_LOG_CHANNEL_ID=0
JOIN_LOG_CHANNEL_ID=0
OFFLINE_NOTICE_CHANNEL_ID=0
OFFLINE_NOTICE_MESSAGE=I am going offline because the computer running me is shutting down. Commands will be unavailable until the bot starts again.
OFFLINE_PRESENCE_MESSAGE=Going offline

# SQLite database path.
DB_PATH=data/bot.db
